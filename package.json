{
  "name": "@webxr-jp/vrm-xr-tracking",
  "version": "0.1.0",
  "description": "Drive a VRM 1.0 avatar from WebXR head and controller tracking (arm IK, hips and crouch, calibration, finger curl) for three.js",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "vite",
    "dev:build": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only",
    "changeset:publish": "changeset publish"
  },
  "keywords": [
    "vrm",
    "webxr",
    "three",
    "ik",
    "avatar",
    "vr",
    "react-three-fiber"
  ],
  "author": "WebXR-JP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebXR-JP/vrm-xr-tracking.git"
  },
  "bugs": {
    "url": "https://github.com/WebXR-JP/vrm-xr-tracking/issues"
  },
  "homepage": "https://github.com/WebXR-JP/vrm-xr-tracking#readme",
  "peerDependencies": {
    "@pixiv/three-vrm": "^3.0.0",
    "@pixiv/three-vrm-animation": "^3.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/xr": "^6.0.0",
    "react": "^19.0.0",
    "three": ">=0.176.0"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "@react-three/xr": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@changesets/cli": "^3.0.3",
    "@iwer/devui": "^1.1.2",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/xr": "^6.6.31",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@types/webxr": "^0.5.24",
    "@vitejs/plugin-react": "^5.1.4",
    "iwer": "^2.8.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
